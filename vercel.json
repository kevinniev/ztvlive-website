{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'Build complete'",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/",
      "destination": "https://ztvlivestream.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "destination": "https://ztvlivestream.com/:path*",
      "permanent": true
    }
  ]
}
